{
  "name": "mcp-aws-codecommit",
  "version": "1.0.0",
  "description": "MCP server for AWS CodeCommit - Full CRUD operations on repositories, branches, files, and pull requests",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-aws-codecommit": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "aws",
    "codecommit",
    "ai",
    "llm",
    "model-context-protocol"
  ],
  "author": "Tushar Gupta",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-codecommit": "^3.750.0",
    "@aws-sdk/credential-providers": "^3.1009.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
